    <script>
        // Variáveis de controle de paginação do artigo
        let currentArticleStep = 1;
        const totalSteps = 3; // Total de "páginas" dentro do artigo

        function showPage(pageId) {
            document.getElementById('home-page').style.display = 'none';
            document.getElementById('article-page').style.display = 'none';
            
            document.getElementById(pageId).style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });

            // Se abrir a página do artigo, reinicia para a página 1 (step-1)
            if (pageId === 'article-page') {
                currentArticleStep = 1;
                updateArticleView();
            }
        }

        // Função para rolar os carrosséis da Home
        function scrollCarousel(carouselId, scrollOffset) {
            const carousel = document.getElementById(carouselId);
            carousel.scrollBy({
                left: scrollOffset,
                behavior: 'smooth'
            });
        }

        // Função ativada pelos botões Anterior e Próximo
        function changeArticlePage(direction) {
            currentArticleStep += direction;
            updateArticleView();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Função responsável por mostrar a parte certa do texto e sumir os botões quando necessário
        function updateArticleView() {
            // Esconde todas as páginas do artigo
            for (let i = 1; i <= totalSteps; i++) {
                document.getElementById('step-' + i).style.display = 'none';
            }
            
            // Mostra a página atual
            document.getElementById('step-' + currentArticleStep).style.display = 'block';

            // Lógica de visibilidade dos botões
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');

            if (currentArticleStep === 1) {
                btnPrev.style.visibility = 'hidden'; // Oculta no primeiro passo
            } else {
                btnPrev.style.visibility = 'visible'; // Mostra nos demais
            }

            if (currentArticleStep === totalSteps) {
                btnNext.style.visibility = 'hidden'; // Oculta no último passo
            } else {
                btnNext.style.visibility = 'visible'; // Mostra nos demais
            }
        }
    </script>
