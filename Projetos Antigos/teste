        /* ================= RESET E VARIÁVEIS ================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --bg-color-outer: #e6ebf5; 
            --bg-color-inner: #ffffff;
            --header-footer-bg: #757575;
            --text-main: #333;
            --gray-light: #e0e0e0;
            --gray-medium: #c0c0c0;
            --gray-dark: #888;
            
            --line-green: #4caf50;
            --line-red: #f44336;
            --line-yellow: #ffeb3b;
        }

        body {
            background-color: var(--bg-color-outer);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .app-container {
            width: 100%;
            max-width: 1200px;
            background-color: var(--bg-color-inner);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
        }

        /* ================= HEADER ================= */
        header {
            background-color: var(--header-footer-bg);
            color: white;
            padding: 1.5rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        /* Estilo aplicado para a imagem da logo real */
        .logo-img {
            height: 35px;
            width: auto;
            object-fit: contain;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            cursor: pointer;
        }

        .nav-links a:hover {
            color: #00e5ff;
        }

        /* ================= PÁGINA INICIAL (CATÁLOGO) ================= */
        .main-content {
            flex: 1;
            padding: 3rem 4rem;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .page-header h1 {
            font-size: 2.2rem;
            font-weight: 500;
        }

        .profile-icon {
            width: 50px;
            height: 50px;
            background-color: var(--gray-light);
            border-radius: 50%;
        }

        .search-bar {
            width: 100%;
            padding: 1rem 1.5rem;
            border-radius: 30px;
            border: none;
            background-color: var(--gray-light);
            font-size: 1rem;
            color: #555;
            outline: none;
            margin-bottom: 1.5rem;
        }

        .suggestions {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 3rem;
        }

        .suggestion-btn {
            flex: 1;
            padding: 0.8rem;
            border-radius: 20px;
            border: none;
            background-color: var(--gray-light);
            color: var(--text-main);
            font-size: 1rem;
            cursor: pointer;
            text-align: center;
        }

        /* Carrossel de Cursos */
        .section-title {
            font-size: 1.5rem;
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .carousel-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 3rem;
        }

        .nav-arrow {
            background: none;
            border: none;
            font-size: 1.5rem;
            font-weight: bold;
            cursor: pointer;
            color: var(--text-main);
            padding: 10px;
        }

        .carousel {
            display: flex;
            gap: 1.5rem;
            overflow-x: hidden;
            scroll-behavior: smooth;
            padding-bottom: 10px;
            flex: 1;
        }

        .card {
            min-width: 220px;
            background-color: #f2f2f2;
            border-radius: 4px;
            padding: 12px;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        /* Estilo para quando não tem imagem (quadrado cinza) */
        .card-img-placeholder {
            width: 100%;
            height: 120px;
            background-color: #8a8a8a;
            margin-bottom: 5px;
        }

        /* NOVA REGRA CSS: Estilo para as imagens reais nos cards */
        .card-img {
            width: 100%;
            height: 120px;
            object-fit: cover;
            display: block;
            margin-bottom: 5px;
        }

        .color-line {
            height: 3px;
            width: 100%;
            margin-bottom: 10px;
        }
        .color-line.green { background-color: var(--line-green); }
        .color-line.red { background-color: var(--line-red); }
        .color-line.yellow { background-color: var(--line-yellow); }

        .card h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .badges {
            display: flex;
            gap: 5px;
            margin-bottom: 10px;
        }

        .badge {
            background-color: #d9d9d9;
            font-size: 0.65rem;
            padding: 3px 6px;
            border-radius: 10px;
            color: #555;
        }

        .card-desc {
            font-size: 0.8rem;
            color: #444;
            margin-bottom: 5px;
        }

        .card-rating {
            font-size: 0.75rem;
            color: #666;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .stars { color: #888; letter-spacing: 1px; }

        /* ================= PÁGINA DO ARTIGO ================= */
        #article-page {
            display: none;
            position: relative;
        }

        .sidebar-toggle {
            position: absolute;
            left: 0;
            top: 50px;
            background-color: #d9d9d9;
            padding: 1.5rem 0.5rem 1.5rem 1.5rem;
            border-radius: 0 40px 40px 0;
            cursor: pointer;
            font-weight: bold;
            font-size: 1.2rem;
            letter-spacing: 2px;
        }

        .article-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem 0;
        }

        .article-title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 500;
            margin-bottom: 3rem;
        }

        .article-section {
            margin-bottom: 2rem;
        }

        .article-section h2 {
            font-size: 1.4rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .article-section p {
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .image-block {
            text-align: center;
            margin: 3rem 0;
        }

        .image-block h3 {
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .image-placeholder-large {
            width: 100%;
            height: 250px;
            background-color: var(--gray-light);
            margin-bottom: 0.5rem;
        }

        .image-caption {
            font-size: 0.8rem;
            color: #666;
        }

        .callout-box {
            background-color: var(--gray-light);
            text-align: center;
            padding: 1.5rem;
            font-size: 1.2rem;
            margin: 2rem auto;
            width: 60%;
        }

        .article-navigation {
            display: flex;
            justify-content: space-between;
            margin-top: 4rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--gray-medium);
        }

        .article-navigation button {
            background-color: var(--gray-light);
            border: none;
            padding: 0.5rem 1.5rem;
            font-size: 1rem;
            cursor: pointer;
            font-weight: 500;
        }

        /* ================= FOOTER ================= */
        footer {
            background-color: var(--header-footer-bg);
            color: white;
            padding: 2rem 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-info p {
            font-size: 0.8rem;
            margin-bottom: 0.5rem;
        }
        
        .footer-info a {
            color: white;
        }

        .social-icons {
            display: flex;
            gap: 1rem;
        }

        .social-icon {
            width: 24px;
            height: 24px;
            background-color: rgba(255,255,255,0.2);
            border-radius: 50%;
        }
    </style>
</head>
